{
  "stylingRules": [
    {
      "$comment": "A rule without viz.pass next to rules that have one: which passes does\nthe background fill belong to? (every pass, or only the first one)",
      "selector": {
        "op": "=",
        "args": [
          {
            "sysId": "dataLayer.id"
          },
          "Zones"
        ]
      },
      "symbolizer": {
        "fill": {
          "color": "lightGray"
        }
      }
    },
    {
      "selector": {
        "op": "=",
        "args": [
          {
            "sysId": "dataLayer.id"
          },
          "Roads"
        ]
      },
      "nestedRules": [
        {
          "selector": {
            "op": "=",
            "args": [
              {
                "sysId": "viz.pass"
              },
              0
            ]
          },
          "symbolizer": {
            "stroke": {
              "color": "black",
              "width": {
                "px": 5.0
              }
            }
          }
        },
        {
          "selector": {
            "op": "=",
            "args": [
              {
                "sysId": "viz.pass"
              },
              1
            ]
          },
          "symbolizer": {
            "stroke": {
              "color": "white",
              "width": {
                "px": 3.0
              }
            }
          }
        }
      ]
    }
  ]
}